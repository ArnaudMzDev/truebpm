{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "COREPACK_ENABLE_STRICT": "0",
        "EXPO_PUBLIC_API_URL": "https://api-truebpm.vercel.app",
        "EXPO_PUBLIC_SOCKET_URL": "https://api-truebpm.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "COREPACK_ENABLE_STRICT": "0",
        "EXPO_PUBLIC_API_URL": "https://api-truebpm.vercel.app",
        "EXPO_PUBLIC_SOCKET_URL": "https://api-truebpm.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
